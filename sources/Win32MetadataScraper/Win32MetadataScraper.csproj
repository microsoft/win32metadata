<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WarningLevel>5</WarningLevel>
    <NoWarn>1701;1702;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" Version="21.1.8.4" />
    <PackageReference Include="ClangSharp.Interop" Version="21.1.8.4" />
    <PackageReference Include="ClangSharp.PInvokeGenerator" Version="21.1.8.4" />
    <PackageReference Include="libclang" Version="21.1.8" />
    <PackageReference Include="libClangSharp" Version="21.1.8.2" />
  </ItemGroup>

</Project>
