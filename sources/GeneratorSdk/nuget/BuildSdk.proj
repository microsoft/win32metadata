<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Pack">
  <Target Name="BuildNativeTools" BeforeTargets="GenerateNuspec" Condition="'$(SkipNativeToolsBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\..\scripts\Build-Win32MetadataTools.ps1&quot;"/>
  </Target>

  <Target Name="SetNuSpecProperties" BeforeTargets="GenerateNuspec" DependsOnTargets="GetBuildVersion">
    <PropertyGroup>
      <NuspecProperties>$(NuspecProperties);Version=$(Version)</NuspecProperties>
      <NoWarn>NU5110,NU5111</NoWarn>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>BuildSdk.nuspec</NuspecFile>
    <NuspecBasePath>..\..\..</NuspecBasePath>
    <PackageType>MSBuildSdk</PackageType>
  </PropertyGroup>
</Project>
