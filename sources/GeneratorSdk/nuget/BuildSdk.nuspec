<?xml version="1.0" encoding="utf-8" ?>
<package>
  <metadata>
    <id>Microsoft.Windows.WinmdGenerator</id>
    <version>$version$</version>
    <authors>Microsoft</authors>
    <owners>Microsoft</owners>
    <title>.NET Win32 Metadata Generator SDK Package</title>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <summary>Generates Windows metadata from C and C++ headers.</summary>
    <description>MSBuild SDK wrapper around windows-clang, windows-rdl, and windows-metadata.</description>
    <projectUrl>https://github.com/microsoft/win32metadata</projectUrl>
    <tags>Win32 Metadata MSBuildSDK</tags>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <icon>images\windows.png</icon>
    <repository type="git" url="https://github.com/microsoft/win32metadata.git" />
  </metadata>

  <files>
    <file src="images\windows.png" target="images"/>
    <file src="sources\GeneratorSdk\sdk\sdk.props" target="sdk\Sdk.props"/>
    <file src="sources\GeneratorSdk\sdk\sdk.targets" target="sdk\Sdk.targets"/>
    <file src="bin\GeneratorSdk\tools\win-x64\win32metadata-tools.exe" target="tools\win-x64"/>
    <file src="bin\GeneratorSdk\tools\win-x64\libclang.dll" target="tools\win-x64"/>
    <file src="generation\WinSDK\inc\*" target="tools\assets\WinSDK\inc"/>
  </files>
</package>
