<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemGroup Condition="'$(UseWinSDKAssets)' == 'true'">
    <WinmdIncludeDir Include="$(WinSDKAssets)\inc"/>
    <WinmdIncludeDir Include="$(SdkIncRoot)" Condition="Exists('$(SdkIncRoot)')"/>
  </ItemGroup>
  <ItemGroup>
    <WinmdIncludeDir Include="$(AdditionalIncludes)" Condition="'$(AdditionalIncludes)' != ''"/>
  </ItemGroup>

  <Target Name="BuildWin32MetadataTools"
          BeforeTargets="EmitWinmd"
          Condition="'$(Win32MetadataToolsManifest)' != ''">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRootPath)scripts\Build-Win32MetadataTools.ps1&quot; -OutputDir &quot;$(Win32MetadataToolsDir)&quot;"/>
  </Target>

  <Target Name="EmitWinmd" BeforeTargets="Build" DependsOnTargets="BuildWin32MetadataTools">
    <Error Condition="'@(Partition)' == ''" Text="At least one Partition item is required."/>
    <Error Condition="'@(WinmdIncludeDir)' == ''" Text="At least one WinmdIncludeDir item is required."/>
    <Error Condition="!Exists('$(Win32MetadataToolsExe)')" Text="WinmdGenerator tool not found at '$(Win32MetadataToolsExe)'."/>
    <Error Condition="!Exists('$(LibClangPath)\libclang.dll')" Text="libclang.dll not found in '$(LibClangPath)'."/>

    <ItemGroup>
      <_WinmdArch Include="$(TargetArchitectures)"/>
    </ItemGroup>
    <PropertyGroup>
      <_WinmdArgs>scrape</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) @(Partition->'--partition &quot;%(FullPath)&quot;', ' ')</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) @(WinmdIncludeDir->'--include &quot;%(FullPath)&quot;', ' ')</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) @(ImportLibs->'--lib &quot;%(FullPath)&quot;', ' ')</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) @(_WinmdArch->'--arch %(Identity)', ' ')</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) @(WinmdScope->'--scope &quot;%(Identity)&quot;', ' ')</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) @(WinmdScopeHeader->'--scope-header &quot;%(Identity)&quot;', ' ')</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) --namespace &quot;$(WinmdRootNamespace)&quot;</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) --assembly-name &quot;$(WinmdAssemblyName)&quot;</_WinmdArgs>
      <_WinmdArgs Condition="'$(WinmdVersion)' != ''">$(_WinmdArgs) --assembly-version &quot;$(WinmdVersion)&quot;</_WinmdArgs>
      <_WinmdArgs>$(_WinmdArgs) --obj &quot;$(WinmdObjDir)&quot; --output &quot;$(OutputWinmd)&quot;</_WinmdArgs>
    </PropertyGroup>

    <Message Text="Generating $(OutputWinmd) with windows-clang/windows-rdl/windows-metadata" Importance="high"/>
    <Exec Command="&quot;$(Win32MetadataToolsExe)&quot; $(_WinmdArgs)"
          EnvironmentVariables="LIBCLANG_PATH=$(LibClangPath)"
          StandardOutputImportance="high"/>
  </Target>

  <Import Condition="'$(MicrosoftNoTargetsSdkImported)' == 'true'" Sdk="Microsoft.Build.NoTargets" Version="3.0.4" Project="sdk.targets"/>

  <Target Name="BeforeClean">
    <RemoveDir Directories="$(ObjDir)"/>
    <Delete Files="$(OutputWinmd)"/>
  </Target>
</Project>
