<?xml version="1.0" encoding="utf-8"?>
<Project>
  <UsingTask TaskName="MetadataTasks.ScanLibs" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.ScrapeHeaders" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.ScrapeConstants" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.SelectNativeConstantToolchainHeaders" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.EmitWinmd" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.CollectGenerationDiagnostics" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.CompileIdls" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.FilterResponseFiles" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.GetPartitionFiles" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.MergeFilesIntoFile" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.PrepSettingsForFunctionPointerFixups" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>
  <UsingTask TaskName="MetadataTasks.PrepSettingsForAutoTypes" AssemblyFile="$(TaskBinDir)\MetadataTasks.dll"/>

  <UsingTask TaskName="GetFirstPartitionNamespace" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v12.0.dll">
    <ParameterGroup>
      <Items ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Namespace ParameterType="System.String" Output="true" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq"/>
      <Code Type="Fragment" Language="cs">Namespace = Items.First().GetMetadata("Namespace");</Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <EnumsJson>$(MSBuildProjectDirectory)\enums.json</EnumsJson>
    <GeneratedDir>$(ObjDir)\generated</GeneratedDir>
    <ScratchOutputDir>$(ObjDir)\scratch</ScratchOutputDir>

    <Win32MetadataScraperAssetsDir>$(Win32MetadataAssetsDir)\scraper</Win32MetadataScraperAssetsDir>

    <ScraperFunctionPointerFixupsRsp>$(GeneratedDir)\scraper.functionPointerFixups.generated.rsp</ScraperFunctionPointerFixupsRsp>
    <EmitterFunctionPointerFixupsRsp>$(GeneratedDir)\emitter.functionPointerFixups.generated.rsp</EmitterFunctionPointerFixupsRsp>
    <EmitterAutoFnPtrRsp>$(GeneratedDir)\emitter.autoFnPtr.$(ScanArch).generated.rsp</EmitterAutoFnPtrRsp>
    <ScraperAutoTypesRsp>$(GeneratedDir)\scraper.autoTypes.generated.rsp</ScraperAutoTypesRsp>
    <GeneratedSourceInputsFile>$(GeneratedDir)\source-inputs.generated.txt</GeneratedSourceInputsFile>
    <ScraperAutoRemapsRsp>$(GeneratedDir)\scraper.autoRemaps.generated.rsp</ScraperAutoRemapsRsp>
    <FinalConstantsScraperHeaderFile>$(GeneratedDir)\ConstantsScraper.header.generated.txt</FinalConstantsScraperHeaderFile>
    <FinalScraperHeaderFile>$(GeneratedDir)\scraper.header.generated.txt</FinalScraperHeaderFile>

    <BaseConstantsScraperHeaderFile>$(Win32MetadataScraperAssetsDir)\ConstantsScraper.header.txt</BaseConstantsScraperHeaderFile>
    <BaseScraperHeaderFile>$(Win32MetadataScraperAssetsDir)\scraper.header.txt</BaseScraperHeaderFile>

    <WinSDKConstantsScraperHeaderFile>$(WinSDKAssets)\ConstantsScraper.header.txt</WinSDKConstantsScraperHeaderFile>
    <WinSDKScraperHeaderFile>$(WinSDKAssets)\scraper.header.txt</WinSDKScraperHeaderFile>

    <WithLibsRsp>$(GeneratedDir)\withLibs.generated.rsp</WithLibsRsp>

    <FilteredRspForHeaders>$(GeneratedDir)\filtered.headers.generated.rsp</FilteredRspForHeaders>
    <FilteredRspForConstants>$(GeneratedDir)\filtered.constants.generated.rsp</FilteredRspForConstants>
    <FilteredRspForEmitter>$(GeneratedDir)\filtered.emitter.generated.rsp</FilteredRspForEmitter>

    <ScrapedConstantsMarker>$(GeneratedDir)\constants.scraped.txt</ScrapedConstantsMarker>
    <ScrapedHeadersMarker>$(GeneratedDir)\scannedheaders.$(ScanArch).txt</ScrapedHeadersMarker>

  </PropertyGroup>

  <ItemGroup Condition="'$(UseWinSDKAssets)' == 'true'">
    <FunctionPointerFixup Include="$(WinSDKAssets)\functionPointerFixups.json"/>
    <AutoTypesForSettingsOnly Include="$(WinSDKAssets)\autotypes.json"/>
    <ScraperRsp Include="$(WinSDKAssets)\scraper.settings.rsp"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(UseWinSDKAssets)' == 'true'">
    <AdditionalIncludes>$(WinSDKAssets)\inc;$(AdditionalIncludes)</AdditionalIncludes>
  </PropertyGroup>

  <Target Name="PrepScraperHeader"
    Inputs="$(BaseScraperHeaderFile);$(ScraperHeader)"
    Outputs="$(FinalScraperHeaderFile)">

    <PropertyGroup><_GenerationFailureStage>PrepScraperHeader</_GenerationFailureStage></PropertyGroup>
    <ItemGroup>
      <InputScraperFiles Include="$(BaseScraperHeaderFile)"/>
      <InputScraperFiles Include="$(ScraperHeader)"/>
      <InputScraperFiles Condition="'$(UseWinSDKAssets)' == 'true'" Include="$(WinSDKScraperHeaderFile)"/>
    </ItemGroup>

    <MergeFilesIntoFile
      InputFiles="@(InputScraperFiles)"
      OutputFile="$(FinalScraperHeaderFile)"/>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="PrepConstantsScraperHeader"
    Inputs="$(BaseConstantsScraperHeaderFile);$(ConstantsScraperHeader)"
    Outputs="$(FinalConstantsScraperHeaderFile)">

    <PropertyGroup><_GenerationFailureStage>PrepConstantsScraperHeader</_GenerationFailureStage></PropertyGroup>
    <ItemGroup>
      <InputScraperFiles Include="$(BaseConstantsScraperHeaderFile)"/>
      <InputScraperFiles Include="$(ConstantsScraperHeader)"/>
      <InputScraperFiles Condition="'$(UseWinSDKAssets)' == 'true'" Include="$(WinSDKConstantsScraperHeaderFile)"/>
    </ItemGroup>

    <MergeFilesIntoFile
      InputFiles="@(InputScraperFiles)"
      OutputFile="$(FinalConstantsScraperHeaderFile)"/>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="PrepSettingsForFunctionPointerFixups" BeforeTargets="Build"
    Inputs="@(FunctionPointerFixup)"
    Outputs="$(ScraperFunctionPointerFixupsRsp);$(EmitterFunctionPointerFixupsRsp)">

    <PropertyGroup><_GenerationFailureStage>PrepSettingsForFunctionPointerFixups</_GenerationFailureStage></PropertyGroup>
    <PrepSettingsForFunctionPointerFixups
      FunctionPointerFixups="@(FunctionPointerFixup)"
      ScraperFunctionPointerFixupsRsp="$(ScraperFunctionPointerFixupsRsp)"
      EmitterFunctionPointerFixupsRsp="$(EmitterFunctionPointerFixupsRsp)"/>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="TrackGeneratedSourceInputs">
    <PropertyGroup><_GenerationFailureStage>TrackGeneratedSourceInputs</_GenerationFailureStage></PropertyGroup>
    <ItemGroup>
      <_CurrentGeneratedSourceInputs Include="@(AutoType -> 'AutoType:%(FullPath)');@(AutoTypesForSettingsOnly -> 'AutoTypesForSettingsOnly:%(FullPath)');@(ManualCs -> 'ManualCs:%(FullPath)')"/>
      <_OwnedScrapedHeadersMarkers Include="$(GeneratedDir)\scannedheaders.*.txt"/>
    </ItemGroup>
    <ReadLinesFromFile File="$(GeneratedSourceInputsFile)" Condition="Exists('$(GeneratedSourceInputsFile)')">
      <Output TaskParameter="Lines" ItemName="_PreviousGeneratedSourceInputs"/>
    </ReadLinesFromFile>
    <PropertyGroup>
      <_GeneratedSourceInputsUnchanged>false</_GeneratedSourceInputsUnchanged>
      <_GeneratedSourceInputsUnchanged Condition="Exists('$(GeneratedSourceInputsFile)') and '@(_PreviousGeneratedSourceInputs)' == '@(_CurrentGeneratedSourceInputs)'">true</_GeneratedSourceInputsUnchanged>
    </PropertyGroup>
    <Delete
      Files="$(ScraperAutoTypesRsp);@(_OwnedScrapedHeadersMarkers);$(ScrapedConstantsMarker);$(OutputWinmd)"
      Condition="'$(_GeneratedSourceInputsUnchanged)' != 'true'"/>
    <MakeDir Directories="$(GeneratedDir)"/>
    <WriteLinesToFile File="$(GeneratedSourceInputsFile)" Lines="@(_CurrentGeneratedSourceInputs)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Condition="'@(ManualCs)' == ''"/>
    <WriteLinesToFile
      File="$(ScraperAutoTypesRsp)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Condition="'@(AutoType);@(AutoTypesForSettingsOnly)' == ';'"/>
    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="PrepSettingsForAutoTypes" BeforeTargets="Build"
    DependsOnTargets="TrackGeneratedSourceInputs"
    Inputs="@(AutoType);@(AutoTypesForSettingsOnly)"
    Outputs="$(ScraperAutoTypesRsp)">

    <PropertyGroup><_GenerationFailureStage>PrepSettingsForAutoTypes</_GenerationFailureStage></PropertyGroup>
    <PrepSettingsForAutoTypes
      AutoTypes="@(AutoType);@(AutoTypesForSettingsOnly)"
      ScraperAutoTypesRsp="$(ScraperAutoTypesRsp)"/>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="CompileIdls" BeforeTargets="Build"
    Inputs="@(Idls)"
    Outputs="@(Idls -> '$(CompiledHeadersDir)\%(Filename).h')">

    <PropertyGroup><_GenerationFailureStage>CompileIdls</_GenerationFailureStage></PropertyGroup>
    <Message Text="Compiling idl files..." Importance="high"/>

    <CompileIdls
      Idls="@(Idls)"
      ObjDir="$(ObjDir)"
      CompiledHeadersDir="$(CompiledHeadersDir)"
      ScriptsDir="$(ScriptsDir)"
      SdkIncRoot="$(SdkIncRoot)"
      SdkBinDir="$(WindowsSDKVersionedBinRoot)"
      AdditionalIncludes="$(AdditionalIncludes)"
      MidlSwitches="$(MidlSwitches)"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"/>
    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="PrepareWithLibsRsp" BeforeTargets="Build"
    Inputs="@(ImportLibs)"
    Outputs="$(WithLibsRsp)">

    <PropertyGroup><_GenerationFailureStage>PrepareWithLibsRsp</_GenerationFailureStage></PropertyGroup>
    <Message Text="Scanning libs..." Importance="high"/>

    <ScanLibs
      Libs="@(ImportLibs)"
      LibToolsBinDir="$(LibToolsBinDir)"
      WithLibsRsp="$(WithLibsRsp)"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)">
    </ScanLibs>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="FilterRsps"
    Inputs="@(ResponseFile)"
    Outputs="$(FilteredRspForHeaders);$(FilteredRspForConstants)">

    <PropertyGroup><_GenerationFailureStage>FilterRsps</_GenerationFailureStage></PropertyGroup>
    <FilterResponseFiles
      ResponseFiles="@(ResponseFile)"
      OutputFileName="$(FilteredRspForHeaders)"
      ValidSwitches="--exclude;--remap;--with-attribute;--with-type;--with-librarypath"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"/>

    <FilterResponseFiles
      ResponseFiles="@(ResponseFile)"
      OutputFileName="$(FilteredRspForConstants)"
      ValidSwitches="--exclude;--requiredNamespaceForName;--with-attribute;--memberRemap;--with-type;--headerPriority"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"/>

    <FilterResponseFiles
      ResponseFiles="@(ResponseFile)"
      OutputFileName="$(FilteredRspForEmitter)"
      ValidSwitches="--memberRemap;--enumMakeFlags;--reducePointerLevel;--requiredNamespaceForName;--autoTypes;--staticLibs;--enumAddition"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"/>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <ItemGroup>
    <Clean Include="obj\**"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Generated settings must come before project/manual RSPs so manual overrides win. -->
    <FinalScraperRsp Include="$(ScraperFunctionPointerFixupsRsp)"/>
    <FinalScraperRsp Include="$(ScraperAutoTypesRsp)"/>
    <FinalScraperRsp Include="@(ScraperRsp)"/>
    <FinalScraperRsp Include="$(FilteredRspForHeaders)"/>
    <FinalScraperRsp Include="$(WithLibsRsp)"/>
    <FinalScraperRsp Include="$(Win32MetadataScraperAssetsDir)\baseSettings.rsp"/>
    <FinalScraperRsp Include="$(Win32MetadataScraperAssetsDir)\baseSettings.*.rsp"/>
  </ItemGroup>

  <ItemGroup>
    <AllTraverseFiles Include="%(Partition.TraverseFiles)"/>
  </ItemGroup>

  <Target Name="SelectNativeConstantToolchainHeaders"
    Condition="'$(EvaluateNativeConstants)' == 'true'">
    <PropertyGroup><_GenerationFailureStage>SelectNativeConstantToolchainHeaders</_GenerationFailureStage></PropertyGroup>
    <SelectNativeConstantToolchainHeaders
      ScriptsDir="$(ScriptsDir)"
      ToolchainIncludeRoots="$(NativeConstantToolchainIncludeRoots)">
      <Output TaskParameter="ToolchainIncludeRoots" PropertyName="NativeConstantToolchainIncludeRoots"/>
    </SelectNativeConstantToolchainHeaders>
    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="ScrapeHeaders" BeforeTargets="Build"
    DependsOnTargets="SelectNativeConstantToolchainHeaders;PrepScraperHeader;PrepSettingsForFunctionPointerFixups;PrepSettingsForAutoTypes;CompileIdls;PrepareWithLibsRsp;FilterRsps">

    <PropertyGroup>
      <_GenerationFailureStage>ScrapeHeaders</_GenerationFailureStage>
    </PropertyGroup>
    <ScrapeHeaders
      Condition="'$(SkipScraping)' != 'true'"
      Partitions="@(Partition)"
      ResponseFiles="@(FinalScraperRsp)"
      AutoRemapsResponseFile="$(ScraperAutoRemapsRsp)"
      ScraperFunctionPointerFixupsRsp="$(ScraperFunctionPointerFixupsRsp)"
      EmitterFunctionPointerFixupsRsp="$(EmitterFunctionPointerFixupsRsp)"
      HeaderTextFile="$(FinalScraperHeaderFile)"
      SdkIncRoot="$(SdkIncRoot)"
      WinSdkRoot="$(TargetPlatformSdkRootOverride)"
      ToolsBinDir="$(ToolsBinDir)"
      ScriptsDir="$(ScriptsDir)"
      AdditionalIncludes="$(AdditionalIncludes)"
      ToolchainIncludeRoots="$(NativeConstantToolchainIncludeRoots)"
      GeneratedDir="$(GeneratedDir)"
      ScratchDir="$(ScratchOutputDir)"
      MaxProcessors="$(MaxProcessors)"
      ScanArch="$(ScanArch)"
      MarkerFileName="$(ScrapedHeadersMarker)"
      Win32MetadataScraperAssetsDir="$(Win32MetadataScraperAssetsDir)"
      ExcludeFromCrossarch="$(ExcludeFromCrossarch)"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"
      PartitionFilter="$(PartitionFilter)"
      EvaluateNativeConstants="$(EvaluateNativeConstants)"
      NuGetPackageSource="$(NuGetPackageSource)">
      <Output TaskParameter="ToolchainIncludeRoots" PropertyName="NativeConstantToolchainIncludeRoots"/>
    </ScrapeHeaders>

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="CopyManualFilesToScraped" BeforeTargets="Build"
    DependsOnTargets="TrackGeneratedSourceInputs">
    <PropertyGroup><_GenerationFailureStage>CopyManualFilesToScraped</_GenerationFailureStage></PropertyGroup>
    <ItemGroup>
      <_CurrentManualCsOutputs Include="@(ManualCs -> '$(GeneratedDir)\%(Filename).manual.cs')"/>
      <_RetiredManualCsOutputs Include="$(GeneratedDir)\*.manual.cs" Exclude="@(_CurrentManualCsOutputs)"/>
    </ItemGroup>
    <Delete Files="@(_RetiredManualCsOutputs)"/>
    <Copy SourceFiles="@(ManualCs)" DestinationFiles="@(_CurrentManualCsOutputs)" SkipUnchangedFiles="$(_GeneratedSourceInputsUnchanged)" />
    <!-- Commit manual identities only after their destination copies succeed. -->
    <WriteLinesToFile File="$(GeneratedSourceInputsFile)" Lines="@(_CurrentGeneratedSourceInputs)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <ItemGroup>
    <AllTraverseFiles Include="%(Partition.TraverseFiles)"/>
  </ItemGroup>

  <ItemGroup>
    <ConstantsScraperRsp Include="$(FilteredRspForConstants)"/>
    <ConstantsScraperRsp Include="$(Win32MetadataScraperAssetsDir)\baseSettings.ConstantsScraper.rsp"/>
  </ItemGroup>

  <Target Name="ScrapeConstants" BeforeTargets="Build"
    DependsOnTargets="SelectNativeConstantToolchainHeaders;PrepConstantsScraperHeader;ScrapeHeaders;CopyManualFilesToScraped">

    <PropertyGroup>
      <DefaultNamespace>DefaultNamespace</DefaultNamespace>
      <_GenerationFailureStage>ScrapeConstants</_GenerationFailureStage>
    </PropertyGroup>
    <Delete Files="$(GeneratedDir)\constants-task-diagnostics.json;$(GeneratedDir)\constants-preflight-diagnostics.json"/>

    <ScrapeConstants
      Condition="'$(SkipScraping)' != 'true' or '$(EvaluateNativeConstants)' == 'true'"
      DefaultNamespace="$(DefaultNamespace)"
      ScraperOutputDir="$(GeneratedDir)"
      ResponseFiles="@(ConstantsScraperRsp)"
      Partitions="@(Partition)"
      ManualCs="@(ManualCs)"
      EnumsJson="$(EnumsJson)"
      ToolsBinDir="$(ToolsBinDir)"
      HeaderTextFile="$(FinalConstantsScraperHeaderFile)"
      MarkerFileName="$(ScrapedConstantsMarker)"
      SdkIncRoot="$(SdkIncRoot)"
      HeaderPriority="$(ConstantHeaderPriority)"
      ToolchainIncludeRoots="$(NativeConstantToolchainIncludeRoots)"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"
      StandardErrorImportance="high"
      />

    <OnError ExecuteTargets="CollectIndependentGenerationDiagnostics"/>
  </Target>

  <Target Name="CollectIndependentGenerationDiagnostics">
    <PropertyGroup>
      <_GenerationFailureStage Condition="'$(_GenerationFailureStage)' == ''">generation prerequisites</_GenerationFailureStage>
    </PropertyGroup>
    <MakeDir Directories="$(GeneratedDir)"/>
    <Delete Files="$(ScrapedHeadersMarker);$(ScrapedConstantsMarker)"/>
    <Delete Files="$(GeneratedDir)\constants-task-diagnostics.json;$(GeneratedDir)\constants-preflight-diagnostics.json"
      Condition="'$(_GenerationFailureStage)' != 'ScrapeConstants'"/>
    <Delete Files="$(GeneratedDir)\emitter-preflight-diagnostics.json"/>
    <Delete Files="$(GeneratedDir)\auto-types-preparation-diagnostics.json"
      Condition="'@(AutoType);@(AutoTypesForSettingsOnly)' == ';'"/>
    <Delete Files="$(GeneratedDir)\function-pointer-preparation-diagnostics.json"
      Condition="'@(FunctionPointerFixup)' == ''"/>
    <Message Text="Collecting independent validation after failed $(_GenerationFailureStage). Dependent finalization, WinMD emission and default tests remain blocked." Importance="high"/>
    <ItemGroup>
      <_PreflightEmitterRsp Include="@(EmitterRsp);$(FilteredRspForEmitter)"/>
    </ItemGroup>
    <PrepSettingsForFunctionPointerFixups
      Condition="'@(FunctionPointerFixup)' != ''"
      PreflightOnly="true"
      FunctionPointerFixups="@(FunctionPointerFixup)"
      ScraperFunctionPointerFixupsRsp="$(ScraperFunctionPointerFixupsRsp)"
      EmitterFunctionPointerFixupsRsp="$(EmitterFunctionPointerFixupsRsp)"
      ContinueOnError="ErrorAndContinue"/>
    <PrepSettingsForAutoTypes
      Condition="'@(AutoType);@(AutoTypesForSettingsOnly)' != ';'"
      PreflightOnly="true"
      AutoTypes="@(AutoType);@(AutoTypesForSettingsOnly)"
      ScraperAutoTypesRsp="$(ScraperAutoTypesRsp)"
      ContinueOnError="ErrorAndContinue"/>
    <Copy SourceFiles="@(ManualCs)" DestinationFiles="@(ManualCs -> '$(GeneratedDir)\%(Filename).manual.cs')"
      SkipUnchangedFiles="true" ContinueOnError="ErrorAndContinue"/>
    <ScrapeConstants
      Condition="'$(_GenerationFailureStage)' != 'ScrapeConstants'"
      PreflightOnly="true"
      BlockedBy="$(_GenerationFailureStage)"
      DefaultNamespace="DefaultNamespace"
      ScraperOutputDir="$(GeneratedDir)"
      ResponseFiles="@(ConstantsScraperRsp)"
      Partitions="@(Partition)"
      ManualCs="@(ManualCs)"
      EnumsJson="$(EnumsJson)"
      ToolsBinDir="$(ToolsBinDir)"
      HeaderTextFile="$(FinalConstantsScraperHeaderFile)"
      MarkerFileName="$(ScrapedConstantsMarker)"
      SdkIncRoot="$(SdkIncRoot)"
      HeaderPriority="$(ConstantHeaderPriority)"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"
      ToolchainIncludeRoots="$(NativeConstantToolchainIncludeRoots)"
      StandardErrorImportance="high"
      ContinueOnError="ErrorAndContinue"/>
    <EmitWinmd
      PreflightOnly="true"
      BlockedBy="$(_GenerationFailureStage)"
      Libs="@(ImportLibs)"
      AutoTypes="@(AutoType)"
      EmitterSourceDir="$(GeneratedDir)"
      ToolsBinDir="$(ToolsBinDir)"
      ResponseFiles="@(_PreflightEmitterRsp)"
      Win32WinmdBinDir="$(Win32WinmdBinDir)"
      WinmdVersion="$(WinmdVersion)"
      OutputWinmd="$(OutputWinmd)"
      ShowOutputDetails="true"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)"
      ContinueOnError="ErrorAndContinue"/>
    <CallTarget Targets="CollectFinalGenerationDiagnostics"/>
  </Target>

  <Target Name="CollectFinalGenerationDiagnostics">
    <CollectGenerationDiagnostics GeneratedDir="$(GeneratedDir)" FailedStage="$(_GenerationFailureStage)"
      AdditionalReports="$(ObjDir)\idl-generation-diagnostics.json"/>
  </Target>

  <Target Name="EmitWinmd" BeforeTargets="Build"
    Inputs="$(ScrapedConstantsMarker);@(AutoType);@(EmitterRsp)"
    Outputs="$(OutputWinmd)"
    DependsOnTargets="ScrapeConstants">

    <PropertyGroup><_GenerationFailureStage>EmitWinmd</_GenerationFailureStage></PropertyGroup>
    <Delete Files="$(GeneratedDir)\generation-diagnostics.json"/>
    <ItemGroup>
      <EmitterRsp Include="$(FilteredRspForEmitter);$(EmitterFunctionPointerFixupsRsp)"/>
      <!-- When scraping ran in this build, include only the current arch's auto-rsp -->
      <EmitterRsp Condition="'$(SkipScraping)' != 'true' and Exists('$(EmitterAutoFnPtrRsp)')" Include="$(EmitterAutoFnPtrRsp)"/>
      <!-- When assets were scraped in separate CI jobs, include all arch-specific auto-rsps -->
      <EmitterRsp Condition="'$(SkipScraping)' == 'true'" Include="$(GeneratedDir)\emitter.autoFnPtr.*.generated.rsp"/>
      <EmitterRsp Include="$(GeneratedDir)\enumsMakeFlags.generated.rsp"/>
      <EmitterRsp Include="$(GeneratedDir)\enumsRemap.rsp"/>
    </ItemGroup>

    <Message Text="Writing winmd..." Importance="high"/>

    <EmitWinmd
      Libs="@(ImportLibs)"
      AutoTypes="@(AutoType)"
      EmitterSourceDir="$(GeneratedDir)"
      ToolsBinDir="$(ToolsBinDir)"
      ResponseFiles="@(EmitterRsp)"
      Win32WinmdBinDir="$(Win32WinmdBinDir)"
      WinmdVersion="$(WinmdVersion)"
      OutputWinmd="$(OutputWinmd)"
      ShowOutputDetails="$(ShowEmitWinmdOutputDetails)"
      MSBuildProjectDirectory="$(MSBuildProjectDirectory)">
    </EmitWinmd>

    <OnError ExecuteTargets="CollectFinalGenerationDiagnostics"/>
  </Target>

  <Target Name="RetireGenerationFailureReportAfterSuccessfulEmit" AfterTargets="EmitWinmd">
    <Delete Files="$(GeneratedDir)\generation-failures.json;$(GeneratedDir)\emitter-preflight-diagnostics.json"
      Condition="Exists('$(OutputWinmd)')"/>
  </Target>

  <Import Condition="'$(MicrosoftNoTargetsSdkImported)' == 'true'" Sdk="Microsoft.Build.NoTargets" Version="3.0.4" Project="sdk.targets"/>

  <Target Name="BeforeClean">
    <RemoveDir Directories="obj" />
    <Delete Files="$(OutputWinmd)"/>
  </Target>

</Project>
