{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Win32 metadata generation diagnostics, version 1",
  "type": "object",
  "required": ["Version", "Status", "Errors", "BlockedStages"],
  "properties": {
    "Version": { "const": 1 },
    "Status": { "enum": ["completed", "completed-with-diagnostics", "rejected", "blocked"] },
    "Errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "BlockedStages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Stage", "Dependency"],
        "properties": {
          "Stage": { "type": "string" },
          "Dependency": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "Reports": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit retained stage-report paths; not a wildcard census."
    },
    "RawInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Path", "Length", "Sha256"],
        "properties": {
          "Path": { "type": "string" },
          "Length": { "type": "integer", "minimum": 0 },
          "Sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
        },
        "additionalProperties": false
      },
      "description": "Constants input artifact pins, without copied input payloads."
    },
    "NativeInputReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Path", "Architecture"],
        "properties": {
          "Path": { "type": "string" },
          "Architecture": { "type": "string" },
          "BindingSource": { "type": ["string", "null"] },
          "SourceFile": { "type": ["string", "null"] },
          "SourceHash": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "Status": { "const": "completed-with-diagnostics" } } },
      "then": {
        "properties": {
          "Errors": {
            "minItems": 1,
            "items": {
              "required": ["BlocksEmission"],
              "properties": { "BlocksEmission": { "const": false } }
            }
          },
          "BlockedStages": { "maxItems": 0 }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "nativeSource": {
      "type": ["object", "null"],
      "required": ["Identity", "NativeName", "Header", "HeaderHash", "Line", "Column", "Name", "Namespace", "TraversedHeader", "Size", "Alignment"],
      "properties": {
        "Identity": { "type": "string" },
        "NativeName": { "type": "string" },
        "Header": { "type": "string" },
        "HeaderHash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "Line": { "type": "integer", "minimum": 1 },
        "Column": { "type": "integer", "minimum": 1 },
        "Name": { "type": "string" },
        "Namespace": { "type": "string" },
        "TraversedHeader": { "type": "boolean" },
        "Size": { "type": "integer", "minimum": -1 },
        "Alignment": { "type": "integer", "minimum": -1 },
        "SourceArchitecture": { "enum": [null, 1, 2, 4] }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["Code", "Stage", "Message", "Cause"],
      "properties": {
        "Code": { "type": "string" },
        "Stage": { "type": "string" },
        "Message": { "type": "string" },
        "BlocksEmission": {
          "type": "boolean",
          "default": true,
          "description": "False retains a recoverable canonical-provider conflict as an error without blocking dependent emission. An absent field remains blocking."
        },
        "Input": { "type": ["string", "null"] },
        "Symbol": { "type": ["string", "null"] },
        "Header": { "type": ["string", "null"] },
        "Line": { "type": ["integer", "null"] },
        "Architecture": { "type": ["string", "null"] },
        "Partition": { "type": ["string", "null"] },
        "SelectedSdkRoot": { "type": ["string", "null"] },
        "IdentityCategory": { "type": ["string", "null"] },
        "SelectedInput": { "type": ["string", "null"] },
        "SelectedStorage": { "type": ["string", "null"] },
        "CandidateStorage": { "type": ["string", "null"] },
        "SelectedSource": { "$ref": "#/$defs/nativeSource" },
        "CandidateSource": { "$ref": "#/$defs/nativeSource" },
        "Cause": {
          "type": "string",
          "description": "Original Exception.ToString(), retained without deduplication."
        }
      },
      "additionalProperties": false
    }
  }
}
