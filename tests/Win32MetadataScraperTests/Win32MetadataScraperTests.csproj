<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <!-- Pins the Newtonsoft.Json brought in transitively by Microsoft.NET.Test.Sdk to a version without CVE-2024-21907. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sources\Win32MetadataScraper\Win32MetadataScraper.csproj" />
    <ProjectReference Include="..\..\sources\ClangSharpSourceToWinmd\ClangSharpSourceToWinmd.csproj" />
    <ProjectReference Include="..\..\sources\GeneratorSdk\MetadataTasks\MetadataTasks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\generation\WinSDK\RecompiledIdlHeaders\shared\win32metadata_annotations.h"
          Link="assets\win32metadata_annotations.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\generation\WinSDK\manual\Metadata.cs"
          Link="assets\Metadata.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\generation\WinSDK\inc\sal.h"
          Link="assets\sal.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\generation\WinSDK\RecompiledIdlHeaders\shared\concurrencysal.h"
          Link="assets\concurrencysal.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sources\GeneratorSdk\tools\assets\scraper\scraper.header.txt"
          Link="assets\scraper.header.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sources\GeneratorSdk\tools\assets\scraper\scraper.header.txt"
          Link="assets\scraper\scraper.header.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sources\GeneratorSdk\tools\assets\scraper\baseSettings*.rsp"
          Link="assets\scraper\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sources\GeneratorSdk\sdk\sdk.targets"
          Link="assets\scraper.sdk.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
