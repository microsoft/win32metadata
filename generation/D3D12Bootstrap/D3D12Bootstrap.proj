<Project>
  <Import Project="..\..\sources\GeneratorSdk\sdk\sdk.props" />
  <PropertyGroup>
    <ToolsBinDir>$(RepoRootPath)bin\$(Configuration)\net10.0</ToolsBinDir>
    <TaskBinDir>$(ToolsBinDir)</TaskBinDir>
    <ScriptsDir>$(RepoRootPath)scripts</ScriptsDir>
    <LibToolsBinDir>$(RepoRootPath)tools</LibToolsBinDir>
    <Win32MetadataAssetsDir>$(RepoRootPath)sources\GeneratorSdk\tools\assets</Win32MetadataAssetsDir>
    <UseWinSDKAssets>true</UseWinSDKAssets>
    <WinSDKAssets>$(RepoRootPath)generation\WinSDK</WinSDKAssets>
    <SdkIncRoot>$(PkgMicrosoft_Windows_SDK_CPP)\c\Include\10.0.28000.0</SdkIncRoot>
    <AdditionalIncludes>$(PkgMicrosoft_Direct3D_D3D12)\build\native\include</AdditionalIncludes>
    <Win32WinmdBinDir>$(PkgMicrosoft_Windows_SDK_Win32Metadata)</Win32WinmdBinDir>
    <OutputWinmd>$(RepoRootPath)bin\d3d12-bootstrap\Microsoft.Direct3D.D3D12.winmd</OutputWinmd>
    <WinmdVersion>1.0.0.0</WinmdVersion>
    <ShowEmitWinmdOutputDetails>true</ShowEmitWinmdOutputDetails>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Windows.SDK.CPP" Version="10.0.28000.2705" />
    <PackageReference Update="Microsoft.Windows.SDK.Win32Metadata" Version="$(LastWin32MetadataReleaseVersion)" />
    <PackageReference Include="Microsoft.Direct3D.D3D12" Version="1.619.3" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.CPP.x64" Version="10.0.28000.2705" GeneratePathProperty="true" PrivateAssets="all" />
    <ImportLibs Include="$(PkgMicrosoft_Windows_SDK_CPP_x64)\c\um\x64\d3d12.lib" />
    <Partition Include="main.cpp">
      <TraverseFiles>$(PkgMicrosoft_Direct3D_D3D12)\build\native\include\d3d12.h;$(PkgMicrosoft_Direct3D_D3D12)\build\native\include\d3d12sdklayers.h;$(PkgMicrosoft_Direct3D_D3D12)\build\native\include\d3d12shader.h;$(PkgMicrosoft_Direct3D_D3D12)\build\native\include\d3d12compiler.h</TraverseFiles>
      <Namespace>Windows.Win32.Graphics.Direct3D12</Namespace>
      <ExcludeFromCrossarch>true</ExcludeFromCrossarch>
    </Partition>
  </ItemGroup>
  <Import Project="..\..\sources\GeneratorSdk\sdk\sdk.targets" />
  <PropertyGroup>
    <WinSDKScraperHeaderFile></WinSDKScraperHeaderFile>
    <WinSDKConstantsScraperHeaderFile></WinSDKConstantsScraperHeaderFile>
  </PropertyGroup>
</Project>
