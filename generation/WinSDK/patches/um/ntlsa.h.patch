+
+_Win32_Enum_(TRUSTED_DOMAIN_TRUST_ATTRIBUTES, ULONG, TRUST_ATTRIBUTE_CROSS_ORGANIZATION, TRUST_ATTRIBUTE_TREAT_AS_EXTERNAL, TRUST_ATTRIBUTE_WITHIN_FOREST);
