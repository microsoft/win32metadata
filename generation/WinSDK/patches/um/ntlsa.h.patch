+
+_Win32_Enum_(TRUSTED_DOMAIN_TRUST_ATTRIBUTES, ULONG, TRUST_ATTRIBUTE_NON_TRANSITIVE, TRUST_ATTRIBUTE_UPLEVEL_ONLY);
