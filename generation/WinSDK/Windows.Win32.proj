<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <OutputWinmd Condition="'$(OutputWinmd)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\bin\Windows.Win32.winmd'))</OutputWinmd>
    <WinmdUsePartitionAuthority Condition="'$(WinmdUsePartitionAuthority)' == ''">true</WinmdUsePartitionAuthority>
  </PropertyGroup>
  <Import Project="..\..\sources\GeneratorSdk\sdk\sdk.props"/>

  <PropertyGroup>
    <Win32MetadataToolsDir>$(RepoRootPath)bin\GeneratorSdk\tools\win-x64</Win32MetadataToolsDir>
    <Win32MetadataToolsExe>$(Win32MetadataToolsDir)\win32metadata-tools.exe</Win32MetadataToolsExe>
    <LibClangPath>$(Win32MetadataToolsDir)</LibClangPath>
    <Win32MetadataToolsManifest>$(RepoRootPath)tools\rust\Cargo.toml</Win32MetadataToolsManifest>
    <Win32MetadataToolsCommand Condition="'$(WinmdUsePartitionAuthority)' == 'true'">pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRootPath)scripts\Prepare-WindowsRsHeaders.ps1&quot; -WinSdkRoot &quot;$(MSBuildProjectDirectory)&quot; -ToolPath &quot;$(Win32MetadataToolsExe)&quot;</Win32MetadataToolsCommand>
    <WinmdVersion Condition="'$(WinmdVersion)' == ''">1.0.0.0</WinmdVersion>
    <TargetArchitectures Condition="'$(TargetArchitectures)' == ''">x64;x86;arm64</TargetArchitectures>
    <SdkIncRoot>$(PkgMicrosoft_Windows_SDK_CPP)\c\include\$(WindowsSdkHeaderVersion)</SdkIncRoot>
    <AdditionalIncludes>$(MSBuildProjectDirectory)\inc</AdditionalIncludes>
    <UseWinSDKAssets>true</UseWinSDKAssets>
    <WinmdUseSdkHeaderManifest>true</WinmdUseSdkHeaderManifest>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Windows.SDK.CPP" Version="$(WindowsSdkCppPackageVersion)" GeneratePathProperty="true"/>
    <PackageReference Include="Microsoft.Windows.SDK.CPP.x64" Version="$(WindowsSdkCppPackageVersion)" GeneratePathProperty="true"/>
    <WinmdPartitionPolicyRoot Include="Partitions" Condition="'$(WinmdUsePartitionAuthority)' == 'true'"/>
    <WinmdNamespaceRoutes Include="requiredNamespacesForNames.rsp" Condition="'$(WinmdUsePartitionAuthority)' == 'true'"/>
    <WinmdIncludeDir Include="obj\RecompiledIdlHeaders" Condition="'$(WinmdUsePartitionAuthority)' == 'true'"/>
    <WinmdIncludeDir Include="AdditionalHeaders\cpdk" Condition="'$(WinmdUsePartitionAuthority)' == 'true'"/>
    <WinmdIncludeDir Include="AdditionalHeaders"/>
    <WinmdIncludeDir Include="Partitions\Com.StructuredStorage"/>
    <ImportLibs Include="$(PkgMicrosoft_Windows_SDK_CPP_x64)\c\um\x64"/>
    <WinmdScopeHeader Include="activation.h;CoreWindow.h;corewindow.h;DocumentSource.h;documentsource.h;EventToken.h;eventtoken.h;hstring.h;inspectable.h"/>
    <WinmdScopeHeader Include="manual.h;MemoryBuffer.h;memorybuffer.h;midlbase.h;rdpappcontainerclient.h"/>
    <WinmdScopeHeader Include="roapi.h;robuffer.h;roerrorapi.h;rometadata.h;rometadataresolution.h;roparameterizediid.h;roregistrationapi.h"/>
    <WinmdScopeHeader Include="shcore.h;WeakReference.h;weakreference.h;webapplication.h"/>
    <WinmdScopeHeader Include="windows.graphics.effects.interop.h;windows.graphics.interop.h;windows.ui.composition.interop.h"/>
    <WinmdScopeHeader Include="winstring.h;Wsdevlicensing.h;wsdevlicensing.h"/>
  </ItemGroup>

  <Target Name="ValidateSdkHeaders" BeforeTargets="BuildWin32MetadataTools">
    <Error Condition="!Exists('$(SdkIncRoot)\um')"
           Text="Pinned Microsoft.Windows.SDK.CPP headers were not found at '$(SdkIncRoot)'."/>
  </Target>

  <Import Project="..\..\sources\GeneratorSdk\sdk\sdk.targets"/>

  <Target Name="BeforeClean">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRootPath)scripts\Prepare-WindowsRsHeaders.ps1&quot; -WinSdkRoot &quot;$(MSBuildProjectDirectory)&quot; -Clean -CleanObjectDirectory &quot;$(WinmdObjDir)&quot; -CleanOutput &quot;$(OutputWinmd)&quot;"/>
  </Target>
</Project>
